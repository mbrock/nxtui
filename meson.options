option('demo', type : 'boolean', value : true,
  description : 'Build bundled demo binaries')

option('tests', type : 'boolean', value : true,
  description : 'Build and register tests')

option('default_wand', type : 'combo', value : 'auto',
  choices : ['auto', 'epoll', 'uring', 'kqueue'],
  description : 'Default application Wand backend (auto: io_uring on Linux, kqueue on BSD/macOS)')

option('wisp_tool', type : 'boolean', value : true,
  description : 'Build the Wisp console and timer host')

option('llm_tool', type : 'boolean', value : true,
  description : 'Build the nxtllm tool')

option('dev', type : 'boolean', value : true,
  description : 'Build the nxt-dev multi-command developer binary')

option('benchmarks', type : 'boolean', value : false,
  description : 'Build benchmark executables')

option('cares', type : 'feature', value : 'auto',
  description : 'Use system c-ares for DNS when available')

option('cpptrace', type : 'feature', value : 'disabled',
  description : 'Use cpptrace for rich exception stack traces')
