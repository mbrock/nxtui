option('demo', type : 'boolean', value : true,
  description : 'Build the bundled nxtdemo UI demo binary')

option('tests', type : 'boolean', value : true,
  description : 'Build and register tests')

option('llm_tool', type : 'boolean', value : true,
  description : 'Build nxtllm trace/debug tool, requires nanoarrow IPC')
