#!/usr/bin/env bash
# Render a Forge/Sterling Alloy XML instance to ANSI via xtc.
#
# Usage:
#   ./cassette/forge-render
#   ./cassette/forge-render --view objects
#   ./cassette/forge-render --compact
#   ./cassette/forge-render docs/generated/forge-graphs/example.xml
#   ./cassette/forge-render --intermediate docs/generated/forge-graphs/example.xml

set -euo pipefail

show_intermediate=0
view="relations"

while [ $# -gt 0 ]; do
    case "$1" in
        --intermediate)
            show_intermediate=1
            shift
            ;;
        --view)
            if [ $# -lt 2 ]; then
                echo "--view requires one of: relations, objects, compact" >&2
                exit 2
            fi
            view="$2"
            shift 2
            ;;
        --relations)
            view="relations"
            shift
            ;;
        --objects)
            view="objects"
            shift
            ;;
        --compact)
            view="compact"
            shift
            ;;
        --help|-h)
            sed -n '4,8p' "$0" | sed 's/^# //'
            exit 0
            ;;
        --*)
            echo "unknown option: $1" >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

case "$view" in
    relations|objects|compact) ;;
    *)
        echo "unknown view: $view" >&2
        echo "expected one of: relations, objects, compact" >&2
        exit 2
        ;;
esac

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/.." && pwd)"
default_xml="$repo/docs/generated/forge-graphs/forge-graph-nxtrt-model.rkt--rich-runtime-shape-witness.xml"
xml_file="${1:-$default_xml}"
style="$here/forge-instance-night.xsl"

if [ ! -f "$xml_file" ]; then
    echo "missing Forge XML: $xml_file" >&2
    echo "run make docs, or pass an XML file path" >&2
    exit 1
fi

xtc_xml="$(xsltproc --stringparam view "$view" "$style" "$xml_file")"

if [ "$show_intermediate" = 1 ]; then
    printf '%s\n' "$xtc_xml"
    exit 0
fi

cols="$(tput cols 2>/dev/null || echo 100)"
xtc --width "$cols" --ansi --xml "$xtc_xml"
