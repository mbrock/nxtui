#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
#   "duckdb>=1.1",
#   "rich>=13.7",
# ]
# ///
from __future__ import annotations

import argparse
import os
import re
import subprocess
from pathlib import Path

import duckdb
from rich.console import Console
from rich.panel import Panel
from rich.text import Text


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Render an io_uring tracepoint report from perf JSON data.")
    parser.add_argument(
        "data",
        nargs="?",
        default="build-bench-release/nxt-echo.uring.perf.data",
        help="perf.data file to convert when JSON is missing or stale")
    parser.add_argument(
        "json",
        nargs="?",
        help="perf JSON file, defaults to DATA with .json suffix")
    parser.add_argument(
        "--comm",
        default=os.environ.get("BENCH_PERF_COMM", "nxt-echo-bench"),
        help="process command name to analyze")
    parser.add_argument(
        "--lines",
        type=int,
        default=int(os.environ.get("BENCH_PERF_DUCK_LINES", "20")),
        help="rows shown in each table")
    parser.add_argument(
        "--min-pct",
        type=float,
        default=float(os.environ.get("BENCH_PERF_MIN_PCT", "3.0")),
        help="minimum percent for distribution rows")
    return parser.parse_args()


def convert_perf_data(data: Path, json_path: Path) -> None:
    if not data.exists():
        raise SystemExit(f"perf data not found: {data}")

    if json_path.exists() and json_path.stat().st_mtime >= data.stat().st_mtime:
        return

    subprocess.run(
        [
            "sudo",
            "perf",
            "data",
            "convert",
            "--force",
            "-i",
            str(data),
            "--to-json",
            str(json_path),
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        ["sudo", "chmod", "a+r", str(json_path)],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def connect(json_path: Path, comm: str) -> duckdb.DuckDBPyConnection:
    con = duckdb.connect()
    con.execute(
        """
        create temp table raw as
            select row_number() over () as eid, unnest(samples) as sample
            from read_json(?, maximum_object_size = 1000000000, union_by_name = true);
        """,
        [str(json_path)],
    )
    con.execute(
        """
        create temp table events as
            select eid, sample
            from raw
            where sample.comm = ?;
        """,
        [comm],
    )
    return con


def sample_fields(con: duckdb.DuckDBPyConnection) -> set[str]:
    row = con.execute("select typeof(sample) from events limit 1").fetchone()
    if row is None:
        return set()
    return set(re.findall(r'(?:^STRUCT\(|, )"?([A-Za-z_][A-Za-z0-9_]*)"? [A-Z]', row[0]))


def as_int(raw: object) -> int:
    if raw is None:
        return 0
    if isinstance(raw, int):
        return raw
    text = str(raw)
    return int(text, 16) if text.startswith("0x") else int(text)


def pct(part: int, total: int) -> str:
    return f"{100.0 * part / max(total, 1):3.0f}"


def n(value: int | float) -> str:
    if isinstance(value, float):
        return f"{value:,.1f}"
    return f"{value:,}"


def row_n(value: int) -> str:
    return str(value)


def count_where(con: duckdb.DuckDBPyConnection, where: str) -> int:
    return con.execute(f"select count(*)::int from events where {where}").fetchone()[0]


def count_field(con: duckdb.DuckDBPyConnection, fields: set[str], field: str) -> int:
    if field not in fields:
        return 0
    return count_where(con, f"sample.{field} is not null")


def event_summary(con: duckdb.DuckDBPyConnection, json_path: Path) -> Panel:
    fields = sample_fields(con)
    total = count_where(con, "true")
    submits = count_field(con, fields, "sq_thread")
    completes = count_field(con, fields, "res")
    enters = count_field(con, fields, "to_submit")
    exits = count_field(con, fields, "ret")
    poll_arms = count_field(con, fields, "mask")
    cq_waits = count_field(con, fields, "min_events")
    async_work = count_field(con, fields, "work")
    rings = con.execute(
        """
        select count(distinct sample.ctx)::int
        from events
        where sample.ctx is not null;
        """
    ).fetchone()[0]
    avg_submit = submits / enters if enters else 0.0
    avg_complete = completes / exits if exits else 0.0
    summary = (
        f"Read {n(total)} io_uring trace events from {json_path}.\n"
        f"The benchmark used {n(rings)} ring"
        f"{'' if rings == 1 else 's'}, submitted {n(submits)} SQEs, "
        f"and completed {n(completes)} CQEs.\n"
        f"It entered the kernel {n(enters)} times and returned {n(exits)} "
        f"times, averaging {avg_submit:.2f} SQEs submitted and "
        f"{avg_complete:.2f} CQEs completed per enter.\n"
        f"The ring armed poll {n(poll_arms)} times, waited on the CQ ring "
        f"{n(cq_waits)} times, and queued async work {n(async_work)} times."
    )
    return Panel.fit(
        summary,
        title="io_uring trace",
        border_style="green",
    )


def count_lines(
    title: str,
    rows: list[tuple[object, int]],
    total: int,
    *,
    key_prefix: str = "",
    min_pct: float,
) -> Text:
    out = Text(title, style="bold")
    for key, count in rows:
        if 100.0 * count / max(total, 1) < min_pct:
            continue
        out.append("\n")
        out.append(f"{pct(count, total)}%  ", style="bold cyan")
        out.append(f"n={row_n(count)}  ", style="dim")
        out.append(f"{key_prefix}{key}")
    return out


def fetch_counts(
    con: duckdb.DuckDBPyConnection,
    expr: str,
    where: str,
    limit: int,
) -> tuple[list[tuple[object, int]], int]:
    rows = con.execute(
        f"""
        select {expr}, count(*)::int as count
        from events
        where {where}
        group by 1
        order by 2 desc, 1
        limit ?;
        """,
        [limit],
    ).fetchall()
    total = count_where(con, where)
    return rows, total


def numeric_counts(
    con: duckdb.DuckDBPyConnection,
    expr: str,
    where: str,
    limit: int,
) -> tuple[list[tuple[int, int]], int]:
    rows, total = fetch_counts(con, expr, where, limit)
    return [(as_int(key), count) for key, count in rows], total


def latency_lines(con: duckdb.DuckDBPyConnection) -> Text:
    row = con.execute(
        """
        with enters as (
            select
                sample.tid as tid,
                row_number() over (
                    partition by sample.tid order by sample.timestamp
                ) as seq,
                sample.timestamp as enter_ts
            from events
            where sample.to_submit is not null
        ),
        exits as (
            select
                sample.tid as tid,
                row_number() over (
                    partition by sample.tid order by sample.timestamp
                ) as seq,
                sample.timestamp as exit_ts
            from events
            where sample.ret is not null
        ),
        paired as (
            select (exit_ts - enter_ts) / 1000.0 as us
            from enters
            join exits using (tid, seq)
            where exit_ts >= enter_ts
        )
        select
            count(*)::int,
            min(us),
            quantile_cont(us, 0.50),
            quantile_cont(us, 0.90),
            quantile_cont(us, 0.99),
            max(us),
            avg(us)
        from paired;
        """
    ).fetchone()
    out = Text("io_uring_enter latency", style="bold")
    if row and row[0]:
        calls, min_us, p50, p90, p99, max_us, avg = row
        out.append("\n")
        out.append(f"n={n(calls)}  ", style="dim")
        out.append(
            f"min={min_us:.1f}us  p50={p50:.1f}us  p90={p90:.1f}us  "
            f"p99={p99:.1f}us  max={max_us:.1f}us  avg={avg:.1f}us")
    return out


def main() -> int:
    args = parse_args()
    data = Path(args.data)
    json_path = Path(args.json) if args.json else data.with_suffix(".json")
    convert_perf_data(data, json_path)

    con = connect(json_path, args.comm)
    if count_where(con, "true") == 0:
        raise SystemExit(f"no trace events found for comm {args.comm!r}")

    console = Console()
    console.print(event_summary(con, json_path))

    rows, total = fetch_counts(
        con,
        "sample.op_str",
        "sample.sq_thread is not null",
        args.lines,
    )
    console.print(count_lines(
        "submitted SQEs by opcode",
        rows,
        total,
        min_pct=args.min_pct,
    ))

    rows, total = numeric_counts(
        con,
        "sample.to_submit",
        "sample.to_submit is not null",
        args.lines,
    )
    console.print(count_lines(
        "number of SQEs submitted per enter",
        rows,
        total,
        min_pct=args.min_pct,
    ))

    rows, total = numeric_counts(
        con,
        "sample.ret",
        "sample.ret is not null",
        args.lines,
    )
    console.print(count_lines(
        "number of SQEs accepted per enter",
        rows,
        total,
        min_pct=args.min_pct,
    ))

    console.print(latency_lines(con))

    rows, total = numeric_counts(
        con,
        "sample.res",
        "sample.res is not null",
        args.lines,
    )
    console.print(count_lines(
        "completion results",
        rows,
        total,
        key_prefix="res=",
        min_pct=args.min_pct,
    ))

    rows, total = fetch_counts(
        con,
        "sample.op_str",
        "sample.mask is not null",
        args.lines,
    )
    if total:
        console.print(count_lines(
            "poll arms by opcode",
            rows,
            total,
            min_pct=args.min_pct,
        ))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
