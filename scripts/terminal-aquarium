#!/usr/bin/env python3
"""terminal-aquarium: a tiny, useless, affectionate aquarium for your terminal.

It prints a one-screen snapshot based on the current terminal size.
The fish positions are pseudo-random but stable for the current minute,
so the tank feels alive without being obnoxious.
"""

from __future__ import annotations

import math
import random
import shutil
import sys
import time
from dataclasses import dataclass

FISH = [
    "><(((('>",
    "><> ",
    "><)))*>",
    "<`)))><",
    ">)))>'>",
    "<><",
    ">(o.o)<",
]
BUBBLES = [".", "o", "O"]
PLANTS = [" /\\ ", " \\|/ ", " /| ", " /\\ "]

def seed_now() -> int:
    t = time.localtime()
    return int(time.mktime((t.tm_year, t.tm_mon, t.tm_mday, t.tm_hour, t.tm_min, 0, 0, 0, -1)))


def clamp(n: int, lo: int, hi: int) -> int:
    return max(lo, min(hi, n))


def place(canvas: list[list[str]], x: int, y: int, s: str) -> None:
    if y < 0 or y >= len(canvas):
        return
    row = canvas[y]
    for i, ch in enumerate(s):
        xx = x + i
        if 0 <= xx < len(row) and ch != " ":
            row[xx] = ch


@dataclass
class Item:
    x: int
    y: int
    glyph: str


def main() -> int:
    cols, rows = shutil.get_terminal_size(fallback=(80, 24))
    cols = max(cols, 40)
    rows = max(rows, 14)

    seed = seed_now() ^ (cols << 8) ^ rows
    rng = random.Random(seed)

    inner_w = cols - 2
    inner_h = rows - 8
    canvas = [[" " for _ in range(inner_w)] for _ in range(inner_h)]

    # A few drifting fish.
    fish_count = clamp((inner_w * inner_h) // 120, 3, 9)
    fish_items: list[Item] = []
    for _ in range(fish_count):
        glyph = rng.choice(FISH)
        x = rng.randint(0, max(0, inner_w - len(glyph)))
        y = rng.randint(0, max(0, inner_h - 1))
        fish_items.append(Item(x, y, glyph))

    # Bubbles rise upward.
    bubble_count = clamp(inner_w // 8, 4, 12)
    for _ in range(bubble_count):
        x = rng.randint(0, inner_w - 1)
        y = rng.randint(0, inner_h - 1)
        glyph = rng.choice(BUBBLES)
        place(canvas, x, y, glyph)
        if y - 1 >= 0 and rng.random() < 0.7:
            place(canvas, x, y - 1, ".")

    # Plants hug the bottom.
    plant_y = inner_h - 1
    for x in range(0, inner_w, max(8, inner_w // 8)):
        plant = rng.choice(PLANTS)
        place(canvas, x, plant_y, plant)

    # Sprinkle a little plankton.
    plankton = max(10, (inner_w * inner_h) // 25)
    for _ in range(plankton):
        x = rng.randint(0, inner_w - 1)
        y = rng.randint(0, inner_h - 1)
        if canvas[y][x] == " ":
            canvas[y][x] = "." if rng.random() < 0.86 else ","

    # Draw fish last so they swim over bubbles.
    for item in fish_items:
        place(canvas, item.x, item.y, item.glyph)

    # A tiny moon phase based on the current minute.
    minute = time.localtime().tm_min
    moon = ["○", "◔", "◑", "◕", "●", "◕", "◑", "◔"][(minute // 8) % 8]

    headlines = [
        "the fish are in a very important meeting",
        "the water is thinking quietly",
        "one bubble has opinions",
        "the aquarium is running on vibes",
        "everything is moist and therefore legal",
    ]
    headline = rng.choice(headlines)

    # Render.
    top = "+" + ("-" * inner_w) + "+"
    bottom = "+" + ("-" * inner_w) + "+"

    print(f"{moon}  terminal aquarium  {time.strftime('%H:%M')}  |  {headline}")
    print(top)
    for row in canvas:
        print("|" + "".join(row) + "|")
    print(bottom)
    print(f"seed: {seed}   size: {cols}x{rows}   fish: {fish_count}   bubbles: {bubble_count}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
