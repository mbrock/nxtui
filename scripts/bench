#!/usr/bin/env bash
set -euo pipefail

bench_bin="${BENCH_BIN:-build-bench-release/nxt-echo-bench}"

bench_clients="${BENCH_CLIENTS:-64}"
bench_messages="${BENCH_MESSAGES:-512}"
bench_payload="${BENCH_PAYLOAD:-64}"
bench_timeout="${BENCH_TIMEOUT_MS:-30000}"
bench_comm="${BENCH_PERF_COMM:-${BENCH_COMM:-$(basename "$bench_bin")}}"

perf_data="${BENCH_PERF_DATA:-build-bench-release/nxt-echo.perf.data}"
perf_json="${BENCH_PERF_DUCK_JSON:-build-bench-release/nxt-echo.perf.json}"
perf_residency="${BENCH_PERF_RESIDENCY:-build-bench-release/nxt-echo.residency.json}"
perf_stdout="${BENCH_PERF_STDOUT:-build-bench-release/nxt-echo.perf.stdout.json}"
perf_freq="${BENCH_PERF_FREQ:-1999}"
perf_callgraph="${BENCH_PERF_CALLGRAPH:-fp}"
perf_hot_limit="${BENCH_PERF_HOT_LIMIT:-0.5}"
perf_hot_lines="${BENCH_PERF_HOT_LINES:-40}"
symbol_width="${BENCH_PERF_SYMBOL_WIDTH:-96}"
duck_lines="${BENCH_PERF_DUCK_LINES:-20}"
tree_depth="${BENCH_PERF_TREE_DEPTH:-9}"
tree_children="${BENCH_PERF_TREE_CHILDREN:-6}"
min_pct="${BENCH_PERF_MIN_PCT:-3.0}"

uring_data="${BENCH_URING_DATA:-build-bench-release/nxt-echo.uring.perf.data}"
uring_json="${BENCH_URING_JSON:-build-bench-release/nxt-echo.uring.perf.json}"

uring_events=(
    io_uring:io_uring_submit_req
    io_uring:io_uring_complete
    io_uring:io_uring_cqring_wait
    io_uring:io_uring_poll_arm
    io_uring:io_uring_queue_async_work
    syscalls:sys_enter_io_uring_enter
    syscalls:sys_exit_io_uring_enter
)

bench_args=(
    --clients "$bench_clients"
    --messages "$bench_messages"
    --payload "$bench_payload"
    --timeout-ms "$bench_timeout"
)

section() {
    printf "\n== %s ==\n" "$1"
}

quiet() {
    local log
    log="$(mktemp)"
    if "$@" >"$log" 2>&1; then
        rm -f "$log"
        return 0
    fi
    cat "$log" >&2
    rm -f "$log"
    return 1
}

require_bench() {
    if [[ -x "$bench_bin" ]]; then
        return
    fi
    printf "benchmark binary not found: %s\n" "$bench_bin" >&2
    printf "run 'make bench-build' first\n" >&2
    exit 2
}

describe_bench() {
    local round_trips=$((bench_clients * bench_messages))
    local bytes_each_way=$((round_trips * bench_payload))
    local transfer_each_way
    transfer_each_way="$(awk -v bytes="$bytes_each_way" 'BEGIN {
        if (bytes < 1048576)
            printf "%.1f KiB", bytes / 1024;
        else
            printf "%.2f MiB", bytes / 1048576;
    }')"

    printf "Benchmark: loopback TCP echo\n"
    printf "Workload: %s clients x %s messages x %s-byte payloads\n" \
        "$bench_clients" "$bench_messages" "$bench_payload"
    printf "Timeout: %sms\n" "$bench_timeout"
    printf "Expected: %s round trips, %s each way\n" \
        "$round_trips" "$transfer_each_way"
    printf "Passes:\n"
    printf "  1. CPU residency + sampled stacks: perf record -F %s --call-graph %s\n" \
        "$perf_freq" "$perf_callgraph"
    printf "  2. io_uring tracepoints: submits, completions, enters, poll arms\n"
    printf "\n"
}

run_plain() {
    require_bench
    section "tcp echo benchmark"
    "$bench_bin" "${bench_args[@]}"
}

run_residency() {
    require_bench
    scripts/bench-residency "$bench_bin" "${bench_args[@]}"
}

record_perf() {
    require_bench
    quiet sudo perf record \
        -F "$perf_freq" \
        -g \
        --call-graph "$perf_callgraph" \
        -o "$perf_data" \
        -- scripts/bench-residency \
            --no-report \
            --emit-json "$perf_residency" \
            --save-stdout "$perf_stdout" \
            "$bench_bin" \
                "${bench_args[@]}"
    sudo chmod a+r "$perf_residency" "$perf_stdout" >/dev/null 2>&1 || true
}

report_perf() {
    sudo perf report -i "$perf_data"
}

hot_perf() {
    sudo perf report -i "$perf_data" --stdio --stdio-color never \
        --no-children --no-call-graph --fields overhead,dso,symbol \
        --percent-limit "$perf_hot_limit" -t '|' 2>/dev/null \
        | awk -F'|' -v width="$symbol_width" 'BEGIN {
            printf "%-8s %-18s %s\n", "Overhead", "DSO", "Symbol";
            printf "%-8s %-18s %s\n", "--------", "---", "------"
        } /^[[:space:]]*[0-9]/ {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1);
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2);
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3);
            if (length($3) > width)
                $3 = substr($3, 1, width - 3) "...";
            printf "%-8s %-18s %s\n", $1, $2, $3
        }' \
        | head "-$perf_hot_lines"
}

duck_perf() {
    BENCH_PERF_DUCK_LINES="$duck_lines" \
    BENCH_PERF_SYMBOL_WIDTH="$symbol_width" \
    BENCH_PERF_TREE_DEPTH="$tree_depth" \
    BENCH_PERF_TREE_CHILDREN="$tree_children" \
    BENCH_PERF_MIN_PCT="$min_pct" \
        scripts/perf-duckdb --comm "$bench_comm" "$perf_data" "$perf_json"
}

run_perf() {
    record_perf
    printf "\n"
    scripts/bench-residency --from-json "$perf_residency"
    printf "\n"
    duck_perf
}

uring_stat() {
    require_bench
    section "io_uring perf stat"
    sudo perf stat -e "$(IFS=,; echo "${uring_events[*]}")" \
        -- "$bench_bin" \
            "${bench_args[@]}"
}

record_uring() {
    require_bench
    quiet sudo perf record \
        -o "$uring_data" \
        -e "$(IFS=,; echo "${uring_events[*]}")" \
        -- "$bench_bin" \
            "${bench_args[@]}"
}

duck_uring() {
    scripts/uring-duckdb --comm "$bench_comm" "$uring_data" "$uring_json"
}

run_uring() {
    record_uring
    printf "\n"
    duck_uring
}

trace_uring() {
    require_bench
    scripts/uring-bpftrace --comm "$bench_comm" -- "$bench_bin" "${bench_args[@]}"
}

usage() {
    cat <<'USAGE'
usage: scripts/bench COMMAND

Commands:
  build          print the Makefile build command
  plain          run the tcp echo benchmark once
  residency      show wall time versus user/system CPU time
  all            run CPU perf/residency and io_uring trace reports
  perf-record    record CPU samples with perf
  perf-report    open interactive perf report
  perf-hot       print compact perf stdio hot list
  perf-duck      render CPU perf.data with DuckDB/Rich
  perf           record CPU samples and render the DuckDB/Rich report
  uring-stat     run quick io_uring tracepoint counters with perf stat
  uring-record   record io_uring tracepoints with perf
  uring-duck     render io_uring perf.data with DuckDB/Rich
  uring          record io_uring tracepoints and render the DuckDB/Rich report
  uring-trace    run the live bpftrace io_uring summary
USAGE
}

case "${1:-all}" in
    build)
        printf "run 'make bench-build'\n"
        ;;
    plain) run_plain ;;
    residency) run_residency ;;
    all)
        describe_bench
        run_perf
        run_uring
        ;;
    perf-record) record_perf ;;
    perf-report) report_perf ;;
    perf-hot) hot_perf ;;
    perf-duck) duck_perf ;;
    perf) run_perf ;;
    uring-stat) uring_stat ;;
    uring-record) record_uring ;;
    uring-duck) duck_uring ;;
    uring) run_uring ;;
    uring-trace) trace_uring ;;
    -h|--help|help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
