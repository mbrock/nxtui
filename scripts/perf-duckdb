#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
#   "duckdb>=1.1",
#   "rich>=13.7",
# ]
# ///
from __future__ import annotations

import argparse
import os
import re
import subprocess
from dataclasses import dataclass, field
from pathlib import Path

import duckdb
from rich import box
from rich.console import Console
from rich.panel import Panel
from rich.table import Table
from rich.text import Text


@dataclass
class TreeNode:
    label: str
    samples: int = 0
    children: dict[str, "TreeNode"] = field(default_factory=dict)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Render a DuckDB/Rich report from perf JSON data.")
    parser.add_argument(
        "data",
        nargs="?",
        default="build-bench-release/nxt-echo.perf.data",
        help="perf.data file to convert when JSON is missing or stale")
    parser.add_argument(
        "json",
        nargs="?",
        help="perf JSON file, defaults to DATA with .json suffix")
    parser.add_argument(
        "--comm",
        default=os.environ.get("BENCH_PERF_COMM", "nxt-echo-bench"),
        help="process command name to analyze")
    parser.add_argument(
        "--lines",
        type=int,
        default=int(os.environ.get("BENCH_PERF_DUCK_LINES", "20")),
        help="rows shown in each table")
    parser.add_argument(
        "--symbol-width",
        type=int,
        default=int(os.environ.get("BENCH_PERF_SYMBOL_WIDTH", "96")),
        help="maximum rendered symbol width")
    parser.add_argument(
        "--tree-depth",
        type=int,
        default=int(os.environ.get("BENCH_PERF_TREE_DEPTH", "9")),
        help="maximum call tree depth")
    parser.add_argument(
        "--tree-children",
        type=int,
        default=int(os.environ.get("BENCH_PERF_TREE_CHILDREN", "6")),
        help="maximum children per call tree node")
    parser.add_argument(
        "--min-pct",
        type=float,
        default=float(os.environ.get(
            "BENCH_PERF_MIN_PCT",
            os.environ.get("BENCH_PERF_TREE_MIN_PCT", "3.0"))),
        help="minimum percent for table rows and call tree nodes")
    parser.add_argument(
        "--tree-min-pct",
        type=float,
        dest="min_pct",
        default=argparse.SUPPRESS,
        help="deprecated alias for --min-pct")
    return parser.parse_args()


def convert_perf_data(data: Path, json_path: Path) -> None:
    if not data.exists():
        raise SystemExit(f"perf data not found: {data}")

    if json_path.exists() and json_path.stat().st_mtime >= data.stat().st_mtime:
        return

    subprocess.run(
        [
            "sudo",
            "perf",
            "data",
            "convert",
            "--force",
            "-i",
            str(data),
            "--to-json",
            str(json_path),
        ],
        check=True,
    )
    subprocess.run(["sudo", "chmod", "a+r", str(json_path)], check=True)


def dso_name(raw: str | None) -> str:
    if not raw:
        return "unknown"
    if raw == "[kernel.kallsyms]":
        return "kernel"
    name = Path(raw).name
    if name.startswith("nxt-echo-bench"):
        return "bench"
    if name.startswith("libstdc++"):
        return "libstdc++"
    if name.startswith("libc.so"):
        return "libc"
    return name


def clean_symbol(raw: str | None) -> str:
    if not raw:
        return "unknown"
    out = re.sub(r" \[clone [^\]]+\]", "", raw)
    if "__gen_vtable_impl" in out and "std::__detail::__variant" in out:
        return "std::variant dispatch"
    if "std::__detail::__variant::_Variant_storage" in out:
        return "std::variant storage"
    if "std::_Sp_counted_ptr_inplace" in out:
        return "std::shared_ptr storage"
    if "std::_Sp_counted_base" in out:
        return "std::shared_ptr refcount"
    if "std::stop_callback<std::function<void ()> >::~stop_callback" in out:
        return "std::stop_callback::~stop_callback()"
    out = re.sub(
        r"\(anonymous namespace\)::([A-Za-z0-9_]+)"
        r"\(\(anonymous namespace\)::.*?\.Frame\*\)",
        r"(anon)::\1",
        out,
    )
    out = re.sub(r"@@GLIBC_[0-9.]+", "", out)
    out = out.replace("std::__cxx11::", "std::")
    out = out.replace("std::__n4861::", "std::")
    out = out.replace("nxtrt::", "rt::")
    return out


def shorten(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    if width <= 3:
        return text[:width]
    return text[: width - 3] + "..."


def render_symbol(dso: str | None, symbol: str | None, width: int) -> Text:
    dso = dso_name(dso)
    symbol = clean_symbol(symbol)
    prefix = "%" if dso == "kernel" else ""
    rendered = shorten(prefix + symbol, width)
    style = {
        "kernel": "magenta",
        "bench": "cyan",
        "libstdc++": "green",
        "libc": "yellow",
    }.get(dso, "white")
    return Text(rendered, style=style)


def connect(json_path: Path, comm: str) -> duckdb.DuckDBPyConnection:
    con = duckdb.connect()
    con.execute(
        """
        create temp table raw as
            select unnest(samples) as sample
            from read_json(?, maximum_object_size = 10000000);
        """,
        [str(json_path)],
    )
    con.execute(
        """
        create temp table samples as
            select row_number() over () as sid, sample
            from raw
            where sample.comm = ?;
        """,
        [comm],
    )
    con.execute(
        """
        create temp table frames as
            select
                sid,
                depth,
                frame.dso as dso,
                frame.symbol as symbol
            from samples,
                unnest(sample.callchain) with ordinality as u(frame, depth)
        where frame.symbol is not null;
        """,
    )
    return con


def metadata(con: duckdb.DuckDBPyConnection, json_path: Path) -> dict[str, object]:
    row = con.execute(
        """
        select
            count(*)::int as samples,
            min(sample.timestamp) as first_ts,
            max(sample.timestamp) as last_ts
        from samples
        """
    ).fetchone()
    comms = con.execute(
        """
        select sample.comm, count(*)::int
        from raw
        group by 1
        order by 2 desc
        """
    ).fetchall()
    return {
        "json": json_path,
        "samples": row[0],
        "first_ts": row[1],
        "last_ts": row[2],
        "comms": comms,
    }


def samples_table(
    title: str,
    rows: list[tuple[str | None, str | None, int]],
    total: int,
    symbol_width: int,
    min_pct: float,
) -> Table:
    table = Table(title=title, box=box.SIMPLE_HEAVY)
    table.add_column("%", justify="right", no_wrap=True)
    table.add_column("samples", justify="right", no_wrap=True)
    table.add_column("symbol")
    for dso, symbol, count in rows:
        pct = 100.0 * count / max(total, 1)
        if pct < min_pct:
            continue
        table.add_row(
            f"{pct:3.0f}",
            str(count),
            render_symbol(dso, symbol, symbol_width),
        )
    return table


def edge_table(
    rows: list[tuple[str | None, str | None, str | None, str | None, int]],
    total: int,
    symbol_width: int,
    min_pct: float,
) -> Table:
    edge_width = max(24, symbol_width // 2)
    table = Table(title="Hot call edges", box=box.SIMPLE_HEAVY)
    table.add_column("%", justify="right", no_wrap=True)
    table.add_column("samples", justify="right", no_wrap=True)
    table.add_column("caller")
    table.add_column("callee")
    for child_dso, child, parent_dso, parent, count in rows:
        pct = 100.0 * count / max(total, 1)
        if pct < min_pct:
            continue
        table.add_row(
            f"{pct:3.0f}",
            str(count),
            render_symbol(parent_dso, parent, edge_width),
            render_symbol(child_dso, child, edge_width),
        )
    return table


def fetch_self(con: duckdb.DuckDBPyConnection, limit: int) -> list[tuple]:
    return con.execute(
        """
        select
            sample.callchain[1].dso as dso,
            sample.callchain[1].symbol as symbol,
            count(*)::int as samples
        from samples
        where sample.callchain[1].symbol is not null
        group by 1, 2
        order by 3 desc
        limit ?
        """,
        [limit],
    ).fetchall()


def fetch_inclusive(con: duckdb.DuckDBPyConnection, limit: int) -> list[tuple]:
    return con.execute(
        """
        select
            dso,
            symbol,
            count(distinct sid)::int as samples
        from frames
        group by 1, 2
        order by 3 desc
        limit ?
        """,
        [limit],
    ).fetchall()


def fetch_edges(con: duckdb.DuckDBPyConnection, limit: int) -> list[tuple]:
    return con.execute(
        """
        select
            child.dso as child_dso,
            child.symbol as child,
            parent.dso as parent_dso,
            parent.symbol as parent,
            count(*)::int as samples
        from frames child
        join frames parent
            on parent.sid = child.sid
            and parent.depth = child.depth + 1
        group by 1, 2, 3, 4
        order by 5 desc
        limit ?
        """,
        [limit],
    ).fetchall()


def fetch_callchains(con: duckdb.DuckDBPyConnection) -> list[list[tuple[str, str]]]:
    rows = con.execute(
        """
        select sample.callchain
        from samples
        where sample.callchain is not null
        """
    ).fetchall()
    chains = []
    for (frames,) in rows:
        chain = []
        for frame in frames or []:
            symbol = frame.get("symbol")
            if symbol is None:
                continue
            chain.append((dso_name(frame.get("dso")), clean_symbol(symbol)))
        if chain:
            chains.append(chain)
    return chains


def build_call_tree(
    chains: list[list[tuple[str, str]]],
    *,
    start_dso: str | None = None,
) -> TreeNode:
    root = TreeNode("samples")
    for chain in chains:
        frames = list(reversed(chain))
        if start_dso is not None:
            start = next(
                (i for i, (dso, _) in enumerate(frames) if dso == start_dso),
                None,
            )
            if start is None:
                continue
            frames = frames[start:]

        root.samples += 1
        node = root
        for dso, symbol in frames:
            key = f"{dso}\0{symbol}"
            child = node.children.get(key)
            if child is None:
                child = TreeNode(f"{dso}\0{symbol}")
                node.children[key] = child
            child.samples += 1
            node = child
    return root


def tree_label(
    node: TreeNode,
    total: int,
    symbol_width: int,
    depth: int,
) -> Text:
    dso, _, symbol = node.label.partition("\0")
    label = Text()
    label.append(" " * depth)
    label.append(f"{100.0 * node.samples / max(total, 1):3.0f}% ", style="bold cyan")
    label.append(f"{node.samples:>5} ", style="dim")
    label.append_text(render_symbol(dso, symbol, symbol_width))
    return label


def add_tree_lines(
    lines: list[Text],
    node: TreeNode,
    total: int,
    *,
    depth: int,
    max_depth: int,
    max_children: int,
    min_pct: float,
    symbol_width: int,
) -> None:
    if depth >= max_depth:
        return

    children = sorted(
        node.children.values(),
        key=lambda item: item.samples,
        reverse=True,
    )
    shown = 0
    hidden_samples = 0
    hidden_nodes = 0
    for child in children:
        pct = 100.0 * child.samples / max(total, 1)
        if shown >= max_children or pct < min_pct:
            hidden_samples += child.samples
            hidden_nodes += 1
            continue
        lines.append(tree_label(child, total, symbol_width, depth))
        add_tree_lines(
            lines,
            child,
            total,
            depth=depth + 1,
            max_depth=max_depth,
            max_children=max_children,
            min_pct=min_pct,
            symbol_width=symbol_width,
        )
        shown += 1

    if hidden_nodes:
        pct = 100.0 * hidden_samples / max(total, 1)
        if pct < min_pct:
            return
        line = Text(style="dim")
        line.append(" " * depth)
        line.append(
            f"{pct:3.0f}% {hidden_samples:>5} "
            f"... {hidden_nodes} colder branches")
        lines.append(line)


def call_tree_text(
    chains: list[list[tuple[str, str]]],
    *,
    subtitle: str,
    start_dso: str | None = None,
    max_depth: int,
    max_children: int,
    min_pct: float,
    symbol_width: int,
) -> Text | None:
    root = build_call_tree(chains, start_dso=start_dso)
    if root.samples == 0:
        return None

    lines = [Text(f"{subtitle} ({root.samples} samples, root -> leaf)", style="bold")]
    add_tree_lines(
        lines,
        root,
        root.samples,
        depth=0,
        max_depth=max_depth,
        max_children=max_children,
        min_pct=min_pct,
        symbol_width=symbol_width,
    )
    out = Text()
    for index, line in enumerate(lines):
        if index:
            out.append("\n")
        out.append_text(line)
    return out


def main() -> int:
    args = parse_args()
    data = Path(args.data)
    json_path = Path(args.json) if args.json else data.with_suffix(".json")
    convert_perf_data(data, json_path)

    con = connect(json_path, args.comm)
    meta = metadata(con, json_path)
    total = int(meta["samples"])
    if total == 0:
        raise SystemExit(f"no samples found for comm {args.comm!r}")

    console = Console()
    comms = ", ".join(f"{comm}:{count}" for comm, count in meta["comms"])
    console.print(
        Panel.fit(
            f"[bold]{args.comm}[/bold]  {total} samples\n"
            f"json: {json_path}\n"
            f"comm samples: {comms}",
            title="perf json",
            border_style="green",
        )
    )

    console.print(samples_table(
        "Self samples",
        fetch_self(con, args.lines),
        total,
        args.symbol_width,
        args.min_pct,
    ))
    console.print(samples_table(
        "Inclusive samples",
        fetch_inclusive(con, args.lines),
        total,
        args.symbol_width,
        args.min_pct,
    ))
    console.print(edge_table(
        fetch_edges(con, args.lines),
        total,
        args.symbol_width,
        args.min_pct,
    ))
    chains = fetch_callchains(con)
    full_tree = call_tree_text(
        chains,
        subtitle="Full call tree",
        max_depth=args.tree_depth,
        max_children=args.tree_children,
        min_pct=args.min_pct,
        symbol_width=min(args.symbol_width, 58),
    )
    if full_tree is not None:
        console.print(full_tree)
    program_tree = call_tree_text(
        chains,
        subtitle="Program call tree",
        start_dso="bench",
        max_depth=args.tree_depth,
        max_children=args.tree_children,
        min_pct=args.min_pct,
        symbol_width=min(args.symbol_width, 58),
    )
    if program_tree is not None:
        console.print(program_tree)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
