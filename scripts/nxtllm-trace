#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["pyarrow"]
# ///
import argparse
import json
import re
import sys
from pathlib import Path


def load_pyarrow():
    import pyarrow as pa  # noqa: F401
    import pyarrow.ipc as ipc

    return ipc


def read_table(path):
    ipc = load_pyarrow()
    with ipc.open_stream(path) as reader:
        return reader.read_all()


def row_payload(row):
    payload = row.get("payload_json")
    if payload is None or payload == "":
        return None
    try:
        return json.loads(payload)
    except json.JSONDecodeError:
        return payload


def compact_rows(table):
    rows = []
    for row in table.to_pylist():
        data = row.get("data") or ""
        if len(data) > 240:
            data = data[:237] + "..."
        rows.append(
            {
                "seq": row.get("seq"),
                "elapsed_ms": row.get("elapsed_ms"),
                "unix_ms": row.get("unix_ms"),
                "phase": row.get("phase"),
                "event_type": row.get("event_type"),
                "data": data,
                "payload": row_payload(row),
            }
        )
    return rows


def print_json(rows):
    print(json.dumps(rows, indent=2, ensure_ascii=False))


def print_jsonlines(rows):
    for row in rows:
        print(json.dumps(row, ensure_ascii=False))


def print_table(rows):
    if not rows:
        return

    columns = list(rows[0].keys())
    text_rows = [
        {
            column: json.dumps(value, ensure_ascii=False)
            if isinstance(value, (dict, list))
            else "" if value is None else str(value)
            for column, value in row.items()
        }
        for row in rows
    ]
    widths = {
        column: max(len(column), *(len(row[column]) for row in text_rows))
        for column in columns
    }
    print("  ".join(column.ljust(widths[column]) for column in columns))
    print("  ".join("-" * widths[column] for column in columns))
    for row in text_rows:
        print("  ".join(row[column].ljust(widths[column]) for column in columns))


def print_sse(table):
    for row in table.to_pylist():
        if row.get("phase") not in {"sse_event", "llm"}:
            continue
        suffix = ""
        payload = row_payload(row)
        if isinstance(payload, dict):
            delta = payload.get("delta")
            if delta is not None:
                suffix = "  " + str(delta).replace("\n", "\\n").replace("\r", "\\r")
            elif isinstance(payload.get("response"), dict):
                status = payload["response"].get("status")
                if status is not None:
                    suffix = f"  status={status}"
            elif isinstance(payload.get("error"), dict):
                code = payload["error"].get("code")
                if code is not None:
                    suffix = f"  error={code}"

        print(
            f"{row.get('seq', 0):5d}  "
            f"{row.get('elapsed_ms', 0):8d}ms  "
            f"{row.get('event_type', ''):<42}{suffix}"
        )


def frame_rows(table):
    return [row for row in table.to_pylist() if row.get("phase") == "frame"]


def print_frames(table):
    rows = []
    for row in frame_rows(table):
        payload = row_payload(row)
        rows.append(
            {
                "seq": row.get("seq"),
                "elapsed_ms": row.get("elapsed_ms"),
                "data": row.get("data"),
                "cols": payload.get("cols") if isinstance(payload, dict) else "",
                "rows": payload.get("rows") if isinstance(payload, dict) else "",
                "bytes": payload.get("bytes") if isinstance(payload, dict) else "",
            }
        )
    print_table(rows)


CSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
ESC_RE = re.compile(r"\x1b.")


def strip_ansi(text):
    text = CSI_RE.sub("", text)
    return ESC_RE.sub("", text)


def print_frame(table, seq, plain):
    candidates = frame_rows(table)
    if seq is None:
        if not candidates:
            print("trace contains no frame rows", file=sys.stderr)
            return 1
        row = candidates[-1]
    else:
        matches = [row for row in candidates if row.get("seq") == seq]
        if not matches:
            print(f"trace contains no frame row with seq={seq}", file=sys.stderr)
            return 1
        row = matches[0]

    payload = row.get("payload_bin")
    if payload is None:
        print(f"frame seq={row.get('seq')} has no payload_bin", file=sys.stderr)
        return 1

    rendered = bytes(payload)
    if plain:
        text = strip_ansi(rendered.decode("utf-8", "replace"))
        sys.stdout.write(text)
        if not text.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.buffer.write(rendered)
        sys.stdout.buffer.write(b"\n")
    return 0


def main():
    parser = argparse.ArgumentParser(
        description="View an nxtllm Arrow IPC trace.",
        usage="scripts/nxtllm-trace [options] TRACE.arrow",
    )
    parser.add_argument("--json", action="store_true", help="emit one JSON array")
    parser.add_argument(
        "--jsonlines",
        "--jsonl",
        action="store_true",
        help="emit one JSON object per row",
    )
    parser.add_argument("--table", action="store_true", help="emit table output")
    parser.add_argument("--sse", action="store_true", help="emit linewise SSE log")
    parser.add_argument("--frames", action="store_true", help="list recorded compositor frame snapshots")
    parser.add_argument("--frame", action="store_true", help="print the last recorded frame as ANSI")
    parser.add_argument("--frame-seq", type=int, help="print a specific recorded frame by seq")
    parser.add_argument("--plain", action="store_true", help="strip ANSI when printing --frame")
    parser.add_argument("--schema", action="store_true", help="show Arrow schema")
    parser.add_argument("trace_path")
    args = parser.parse_args()

    path = Path(args.trace_path)
    if not path.is_file():
        print(f"trace Arrow IPC file not found: {path}", file=sys.stderr)
        return 1

    table = read_table(path)

    if args.schema:
        print(table.schema)
        return 0

    if args.sse:
        print_sse(table)
        return 0

    if args.frames:
        print_frames(table)
        return 0

    if args.frame or args.frame_seq is not None:
        return print_frame(table, args.frame_seq, args.plain)

    rows = compact_rows(table)

    if args.jsonlines:
        print_jsonlines(rows)
    elif args.table:
        print_table(rows)
    else:
        print_json(rows)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
