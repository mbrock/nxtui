+      "/no-name.frg"))
+
+(define (run-instance->xml-string the-run inst)
+  (define tuple-annotations (hash))
+  (solution-to-XML-string inst
+                          (get-relation-map the-run)
+                          (Run-name the-run)
+                          (run-command-string the-run)
+                          (run-filepath the-run)
+                          (get-bitwidth (Run-run-spec the-run))
+                          forge-version
+                          #:tuple-annotations tuple-annotations
+                          #:run-options (State-options (Run-spec-state (Run-run-spec the-run)))))
+
+(define (select-export-run-name curr-state useful-run-names)
+  (define requested (get-option curr-state 'export_run))
+  (cond
+    [(symbol? requested) requested]
+    [(string? requested) (string->symbol requested)]
+    [(and (not requested) (empty? useful-run-names))
+     (raise-forge-error
+      #:msg "Cannot export XML because there are no commands with instances to export."
+      #:context #f)]
+    [(and (not requested) (empty? (rest useful-run-names)))
+     (first useful-run-names)]
+    [else
+     (raise-forge-error
+      #:msg (format "Cannot infer which command to export. Set option export_run to one of: ~a"
+                    useful-run-names)
+      #:context #f)]))
+
+(define (export-xml-if-requested! curr-state runmap useful-run-names)
+  (define output-path (get-option curr-state 'export_xml))
+  (when output-path
+    (define run-name (select-export-run-name curr-state useful-run-names))
+    (unless (hash-has-key? runmap run-name)
+      (raise-forge-error
+       #:msg (format "Cannot export XML for unknown command ~a. Available commands: ~a"
+                     run-name
+                     (hash-keys runmap))
+       #:context #f))
+    (define the-run (hash-ref runmap run-name))
+    (define inst (tree:get-value (Run-result the-run)))
+    (set-box! (Run-last-sterling-instance the-run) inst)
+    (define xml (run-instance->xml-string the-run inst))
+    (make-parent-directory* output-path)
+    (call-with-output-file output-path
+      (lambda (out) (display xml out))
+      #:exists 'replace)
+    (when (@>= (get-verbosity) VERBOSITY_LOW)
+      (printf "Wrote Alloy XML for ~a to ~a~n" run-name output-path))))
   
